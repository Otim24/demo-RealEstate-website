---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import staircaseImg from '../assets/images/material-staircase.jpg';
import courtyardImg from '../assets/images/courtyard-townhouse.jpg';

const pillars = [
  {
    num: '01',
    title: 'Verified Title & Due Diligence',
    body: 'Before any home enters the Demo Real Estate portfolio, our legal desk verifies Freehold, Leasehold, or Private Mailo title deeds, boundary surveys, and municipal occupation permits.'
  },
  {
    num: '02',
    title: 'Transparent UGX Valuations',
    body: 'We quote and structure all residential transactions clearly in Ugandan Shillings, providing buyers and diaspora families with straightforward comparables and milestone schedules.'
  },
  {
    num: '03',
    title: 'End-to-End Handover Care',
    body: 'From private chauffeur tours and architectural inspections to utility transfers and interior setup, our team guides buyers smoothly well past closing day.'
  }
];

const partners = [
  {
    name: 'Sarah Namukasa',
    role: 'Managing Partner, Kampala (Kololo)',
    bio: 'Leads diplomatic and executive residential placements across Kololo, Nakasero, and Bugolobi with 14 years of Uganda property advisory.'
  },
  {
    name: 'David Okello',
    role: 'Head of Legal & Valuations',
    bio: 'Oversees land registry title verification, survey audits, and structured UGX escrow closings for local and diaspora buyers.'
  },
  {
    name: 'Grace Birungi',
    role: 'Senior Advisor, Entebbe & Western Uganda',
    bio: 'Specializes in Lake Victoria waterfront estates in Entebbe and Munyonyo alongside highland retreats in Fort Portal.'
  }
];

const offices = [
  {
    city: 'Kampala (Kololo)',
    address: 'Acacia Avenue 24, Kololo, Kampala',
    hours: 'Monday to Saturday, 08:30 to 18:00 EAT',
    phone: '+256 772 410 890'
  },
  {
    city: 'Entebbe Waterfront',
    address: 'Bugonga Road 12, Entebbe',
    hours: 'Monday to Saturday, 09:00 to 17:30 EAT',
    phone: '+256 752 814 320'
  },
  {
    city: 'Fort Portal',
    address: 'Kabarole Ridge Suite 3, Fort Portal',
    hours: 'By Appointment',
    phone: '+256 782 619 045'
  }
];
---

<BaseLayout
  title="About Us | Demo Real Estate Uganda"
  description="Meet the advisory partners and property standards behind Demo Real Estate."
>
  <section class="bg-accent pt-12 pb-16 text-canvas sm:pt-16 lg:pt-20 lg:pb-20">
    <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7" data-reveal="fade-left">
          <p class="text-xs font-medium tracking-[0.2em] text-bronze uppercase">02 / About Demo Real Estate</p>
          <h1 class="mt-4 font-serif text-4xl leading-[1.05] font-medium text-canvas sm:text-5xl lg:text-6xl">
            Trusted residential advisory across Uganda's finest neighborhoods.
          </h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-canvas/80 sm:text-lg">
            Demo Real Estate connects discerning buyers, diplomatic missions, and returning diaspora families with architectural villas, gated residences, and lakefront estates backed by verified titles.
          </p>

          <div class="mt-10 grid grid-cols-1 gap-5 border-t border-canvas/15 pt-8 sm:grid-cols-3 max-w-xl">
            <div>
              <p class="font-serif text-3xl font-semibold text-bronze sm:text-4xl">UGX 180B+</p>
              <p class="mt-1 text-[11px] tracking-[0.12em] text-canvas/70 uppercase">Sales Placed</p>
            </div>
            <div>
              <p class="font-serif text-3xl font-semibold text-bronze sm:text-4xl">3</p>
              <p class="mt-1 text-[11px] tracking-[0.12em] text-canvas/70 uppercase">Uganda Desks</p>
            </div>
            <div>
              <p class="font-serif text-3xl font-semibold text-bronze sm:text-4xl">100%</p>
              <p class="mt-1 text-[11px] tracking-[0.12em] text-canvas/70 uppercase">Title Audited</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5" data-reveal="curtain-up" data-delay="1">
          <div class="overflow-hidden border border-canvas/15 bg-canvas/5 p-3">
            <Image
              src={staircaseImg}
              alt="Travertine staircase gallery inside Lubowa Gallery Residence"
              class="aspect-[4/5] w-full object-cover"
              widths={[640, 1024]}
              sizes="(max-width: 1024px) 100vw, 40vw"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12">
      <div class="mb-12" data-reveal="fade-up">
        <p class="text-xs font-medium tracking-[0.18em] text-bronze uppercase">Our Standards</p>
        <h2 class="mt-2 font-serif text-3xl font-medium text-ink sm:text-4xl">
          How Demo Real Estate protects every buyer
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          pillars.map((pillar, idx) => (
            <article
              class="border-t-2 border-bronze bg-canvas p-7 shadow-sm"
              data-reveal="zoom-in"
              data-delay={String(idx + 1)}
            >
              <span class="font-serif text-3xl font-semibold text-bronze">{pillar.num}</span>
              <h3 class="mt-4 font-serif text-2xl font-medium text-ink">{pillar.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5" data-reveal="fade-left">
        <div class="overflow-hidden bg-surface shadow-xl">
          <Image
            src={courtyardImg}
            alt="Inner limestone courtyard in Munyonyo residence"
            class="aspect-[4/5] w-full object-cover"
            widths={[640, 1024]}
            sizes="(max-width: 1024px) 100vw, 38vw"
          />
        </div>
      </div>

      <div class="lg:col-span-7" data-reveal="fade-right">
        <p class="text-xs font-medium tracking-[0.18em] text-bronze uppercase">Leadership Team</p>
        <h2 class="mt-2 font-serif text-3xl font-medium text-ink sm:text-4xl">
          Senior Property Advisors
        </h2>

        <div class="mt-8 divide-y divide-rule border-y border-rule">
          {
            partners.map((partner) => (
              <div class="grid grid-cols-1 gap-2 py-6 sm:grid-cols-12 sm:gap-6">
                <div class="sm:col-span-5">
                  <h3 class="font-serif text-2xl font-medium text-ink">{partner.name}</h3>
                  <p class="mt-1 text-xs font-medium tracking-[0.1em] text-bronze uppercase">{partner.role}</p>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-muted sm:col-span-7 sm:mt-0">
                  {partner.bio}
                </p>
              </div>
            ))
          }
        </div>

        <div class="mt-12">
          <p class="text-xs font-medium tracking-[0.18em] text-bronze uppercase">Regional Desks</p>
          <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-3">
            {
              offices.map((office) => (
                <div class="border border-rule bg-surface p-4">
                  <h3 class="font-serif text-xl font-medium text-ink">{office.city}</h3>
                  <p class="mt-2 text-xs leading-relaxed text-muted">{office.address}</p>
                  <p class="mt-2 text-xs font-medium text-accent">{office.phone}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/contact"
            class="inline-flex min-h-[48px] items-center gap-3 bg-accent px-7 py-3 text-xs font-medium tracking-[0.14em] text-canvas uppercase transition-colors hover:bg-bronze hover:text-ink"
          >
            <span>Book an Office Meeting</span>
            <ArrowIcon class="h-3 w-4" />
          </a>
          <a
            href="https://wa.me/256772410890?text=Hello%20Demo%20Real%20Estate%2C%20I%20would%20like%20to%20speak%20with%20an%20advisor."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[48px] items-center gap-2.5 bg-whatsapp px-6 py-3 text-xs font-medium tracking-[0.14em] text-canvas uppercase transition-colors hover:bg-ink"
          >
            <WhatsAppIcon class="h-4 w-4" />
            <span>Message on WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
