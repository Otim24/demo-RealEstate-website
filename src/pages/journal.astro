---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { journalEntries } from '../data/journal';

const leadEntry = journalEntries[0];
const archiveEntries = journalEntries.slice(1);
---

<BaseLayout
  title="Market Journal | Demo Real Estate Uganda"
  description="Insights on Uganda prime residential property, architecture, and UGX investment trends."
>
  <section class="bg-accent pt-12 pb-14 text-canvas sm:pt-16 lg:pt-20">
    <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12">
      <div class="max-w-3xl" data-reveal="fade-left">
        <p class="text-xs font-medium tracking-[0.2em] text-bronze uppercase">03 / Market Journal</p>
        <h1 class="mt-3 font-serif text-4xl leading-[1.06] font-medium text-canvas sm:text-5xl lg:text-6xl">
          Uganda Property Insights &amp; Architectural Notes
        </h1>
        <p class="mt-4 text-sm leading-relaxed text-canvas/75 sm:text-base">
          Research dispatches from Demo Real Estate advisors covering Kololo, Nakasero, Munyonyo, and the Entebbe waterfront corridor.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 py-14 sm:px-8 sm:py-16 lg:px-12 lg:py-20">
    <article class="grid grid-cols-1 gap-8 border border-rule bg-white p-7 shadow-lg sm:p-10 lg:grid-cols-12 lg:gap-12" data-reveal="zoom-in">
      <div class="lg:col-span-4">
        <span class="inline-block bg-bronze px-3 py-1 text-[11px] font-semibold tracking-[0.14em] text-ink uppercase">
          Featured Report / {leadEntry.number}
        </span>
        <p class="mt-4 text-xs font-medium tracking-[0.12em] text-muted uppercase">
          {leadEntry.category} / {leadEntry.date}
        </p>
        <p class="mt-1 text-xs text-muted">{leadEntry.readTime}</p>
        <p class="mt-4 text-xs font-medium text-ink">{leadEntry.author}</p>
      </div>

      <div class="lg:col-span-8">
        <a href={`/journal/${leadEntry.slug}`} class="group block">
          <h2 class="font-serif text-3xl leading-tight font-medium text-ink transition-colors duration-300 group-hover:text-bronze sm:text-4xl">
            {leadEntry.title}
          </h2>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
            {leadEntry.excerpt}
          </p>
          <span class="mt-7 inline-flex min-h-[44px] items-center gap-3 bg-accent px-5 py-2.5 text-xs font-medium tracking-[0.14em] text-canvas uppercase transition-colors group-hover:bg-bronze group-hover:text-ink">
            <span>Read Full Report</span>
            <ArrowIcon class="h-3 w-4 transition-transform duration-300 group-hover:translate-x-1" />
          </span>
        </a>
      </div>
    </article>

    <div class="mt-14">
      <p class="text-xs font-medium tracking-[0.18em] text-bronze uppercase" data-reveal="fade-up">
        Recent Articles
      </p>

      <div class="mt-5 space-y-5">
        {
          archiveEntries.map((entry, idx) => (
            <a
              href={`/journal/${entry.slug}`}
              class="group grid grid-cols-1 gap-4 border border-rule bg-surface p-6 transition-colors hover:bg-white hover:shadow-md md:grid-cols-12 md:items-center md:gap-8"
              data-reveal={idx % 2 === 0 ? 'fade-left' : 'fade-right'}
            >
              <div class="flex items-center gap-4 md:col-span-3">
                <span class="font-serif text-2xl font-semibold text-bronze">{entry.number}</span>
                <span class="bg-canvas px-2.5 py-1 text-[11px] font-medium tracking-[0.12em] text-accent uppercase">
                  {entry.category}
                </span>
              </div>
              <div class="md:col-span-6">
                <h3 class="font-serif text-2xl font-medium text-ink transition-colors group-hover:text-bronze sm:text-3xl">
                  {entry.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{entry.excerpt}</p>
              </div>
              <div class="flex items-center justify-between md:col-span-3 md:justify-end md:gap-5">
                <span class="text-xs text-muted">{entry.date}</span>
                <ArrowIcon class="h-3 w-4 text-ink transition-transform duration-300 group-hover:translate-x-1" />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
