---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { properties } from '../../data/properties';

export function getStaticPaths() {
  return properties.map((property) => ({
    params: { slug: property.slug },
    props: { property }
  }));
}

const { property } = Astro.props;
const currentIndex = properties.findIndex((p) => p.slug === property.slug);
const prevProperty = properties[(currentIndex - 1 + properties.length) % properties.length];
const nextProperty = properties[(currentIndex + 1) % properties.length];
const whatsappText = encodeURIComponent(
  `Hello Demo Real Estate, I would like to request floor plans or book a private viewing for ${property.title} (${property.price}).`
);
---

<BaseLayout
  title={`${property.title} | Demo Real Estate Uganda`}
  description={property.summary}
>
  <article class="pb-16">
    <!-- Top Dark Emerald Header Band -->
    <header class="bg-accent pt-8 pb-12 text-canvas sm:pt-12 sm:pb-14">
      <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12">
        <div class="flex flex-wrap items-center justify-between gap-4" data-reveal="fade-up">
          <a
            href="/properties"
            class="inline-flex min-h-[44px] items-center gap-3 text-xs font-medium tracking-[0.14em] text-canvas/75 uppercase transition-colors hover:text-bronze"
          >
            <ArrowIcon direction="left" class="h-3 w-4" />
            <span>Back to All Properties</span>
          </a>
          <span class="bg-bronze px-3.5 py-1 text-[11px] font-semibold tracking-[0.16em] text-ink uppercase">
            {property.status}
          </span>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-6 border-t border-canvas/15 pt-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8" data-reveal="fade-left">
            <p class="text-xs font-medium tracking-[0.16em] text-bronze uppercase">
              {property.featuredLabel} / {property.location}, {property.region}
            </p>
            <h1
              data-property-title={property.title}
              class="mt-3 font-serif text-4xl leading-[1.04] font-medium text-canvas sm:text-5xl lg:text-6xl"
            >
              {property.title}
            </h1>
            <p class="mt-2 font-serif text-xl italic text-canvas/75 sm:text-2xl">
              {property.subtitle}
            </p>
          </div>

          <div class="lg:col-span-4 lg:text-right" data-reveal="fade-right">
            <p class="text-[11px] font-medium tracking-[0.16em] text-bronze uppercase">Asking Price</p>
            <p class="mt-1 font-serif text-3xl font-semibold text-canvas sm:text-4xl">{property.price}</p>
          </div>
        </div>
      </div>
    </header>

    <!-- Primary Feature Image -->
    <section class="mx-auto max-w-[1440px] px-5 pt-8 sm:px-8 lg:px-12">
      <div class="overflow-hidden bg-surface shadow-xl" data-reveal="curtain-up">
        <Image
          src={property.image}
          alt={property.imageAlt}
          class="aspect-[4/3] w-full object-cover sm:aspect-[16/9]"
          widths={[720, 1440]}
          sizes="100vw"
          loading="eager"
        />
      </div>
    </section>

    <!-- Dossier Body & Action Sidebar -->
    <section class="mx-auto max-w-[1440px] px-5 pt-12 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <div class="border-l-4 border-bronze bg-surface p-6 sm:p-8" data-reveal="fade-left">
            <p class="text-xs font-medium tracking-[0.16em] text-accent uppercase">Property Overview</p>
            <p class="mt-3 font-serif text-2xl leading-snug text-ink sm:text-3xl">
              {property.summary}
            </p>
          </div>

          <div class="mt-8 space-y-6 text-base leading-[1.8] text-muted">
            {
              property.narrative.map((para, idx) => (
                <p data-reveal="fade-up" data-delay={String(Math.min(idx + 1, 3))}>
                  {para}
                </p>
              ))
            }
          </div>

          <div class="mt-12 bg-surface p-6 sm:p-8" data-reveal="zoom-in">
            <p class="text-xs font-medium tracking-[0.16em] text-accent uppercase">Key Materials &amp; Finishes</p>
            <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {
                property.materials.map((material) => (
                  <li class="border-l-2 border-bronze bg-canvas px-4 py-3 text-sm font-medium text-ink shadow-xs">
                    {material}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="mt-10" data-reveal="curtain-up">
            <div class="overflow-hidden bg-surface shadow-lg">
              <Image
                src={property.secondaryImage}
                alt={property.secondaryImageAlt}
                class="aspect-[4/3] w-full object-cover"
                widths={[640, 1080]}
                sizes="(max-width: 1024px) 100vw, 55vw"
              />
            </div>
            <p class="mt-3 text-xs font-medium tracking-[0.12em] text-muted uppercase">
              {property.secondaryImageAlt}
            </p>
          </div>
        </div>

        <!-- Sticky Specification & WhatsApp Sidebar -->
        <aside class="lg:col-span-5" data-reveal="fade-right">
          <div class="border border-rule bg-white p-6 shadow-xl sm:p-8 lg:sticky lg:top-28">
            <div class="border-b border-rule pb-4">
              <p class="text-[11px] font-medium tracking-[0.18em] text-bronze uppercase">Property Specifications</p>
              <p class="mt-1 font-serif text-3xl font-semibold text-accent">{property.price}</p>
            </div>

            <dl class="mt-4 divide-y divide-rule text-sm">
              <div class="flex justify-between gap-4 py-3">
                <dt class="shrink-0 text-xs font-medium tracking-[0.1em] text-muted uppercase">Location</dt>
                <dd class="text-right font-medium text-ink">{property.region}</dd>
              </div>
              <div class="flex justify-between gap-4 py-3">
                <dt class="shrink-0 text-xs font-medium tracking-[0.1em] text-muted uppercase">Architect</dt>
                <dd class="text-right text-ink">{property.architect}</dd>
              </div>
              <div class="flex justify-between gap-4 py-3">
                <dt class="shrink-0 text-xs font-medium tracking-[0.1em] text-muted uppercase">Completion</dt>
                <dd class="text-right text-ink">{property.year}</dd>
              </div>
              <div class="flex justify-between gap-4 py-3">
                <dt class="shrink-0 text-xs font-medium tracking-[0.1em] text-muted uppercase">Interior Area</dt>
                <dd class="text-right font-medium text-ink">{property.area}</dd>
              </div>
              <div class="flex justify-between gap-4 py-3">
                <dt class="shrink-0 text-xs font-medium tracking-[0.1em] text-muted uppercase">Land Size</dt>
                <dd class="text-right text-ink">{property.plot}</dd>
              </div>
              <div class="flex justify-between gap-4 py-3">
                <dt class="shrink-0 text-xs font-medium tracking-[0.1em] text-muted uppercase">Configuration</dt>
                <dd class="text-right text-ink">{property.bedrooms} Bed / {property.bathrooms} Bath</dd>
              </div>
              {
                property.highlights.map((hl) => (
                  <div class="flex justify-between gap-4 py-3">
                    <dt class="shrink-0 text-xs font-medium tracking-[0.1em] text-muted uppercase">{hl.label}</dt>
                    <dd class="text-right text-ink">{hl.value}</dd>
                  </div>
                ))
              }
            </dl>

            <div class="mt-8 space-y-3">
              <a
                href={`https://wa.me/256772410890?text=${whatsappText}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex min-h-[48px] w-full items-center justify-center gap-3 bg-whatsapp px-6 py-3 text-xs font-medium tracking-[0.14em] text-canvas uppercase transition-colors duration-300 hover:bg-accent"
              >
                <WhatsAppIcon class="h-4 w-4" />
                <span>WhatsApp Agent About This Home</span>
              </a>

              <a
                href={`/contact?residence=${property.slug}`}
                class="flex min-h-[48px] w-full items-center justify-center gap-3 bg-accent px-6 py-3 text-xs font-medium tracking-[0.14em] text-canvas uppercase transition-colors duration-300 hover:bg-bronze hover:text-ink"
              >
                <span>Schedule Private Viewing</span>
                <ArrowIcon class="h-3 w-4" />
              </a>

              <p class="pt-1 text-center text-xs text-muted">
                Title verification documents and UGX payment schedules available on request.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- Adjacent Residences -->
    <section class="mx-auto max-w-[1440px] px-5 pt-16 sm:px-8 lg:px-12">
      <nav
        aria-label="Adjacent properties"
        class="grid grid-cols-1 gap-6 border-t border-rule pt-10 sm:grid-cols-2"
        data-reveal="fade-up"
      >
        <a href={`/properties/${prevProperty.slug}`} class="group flex flex-col gap-2 bg-surface p-6 transition-colors hover:bg-accent hover:text-canvas">
          <span class="inline-flex items-center gap-2 text-[11px] font-medium tracking-[0.16em] text-bronze uppercase">
            <ArrowIcon direction="left" class="h-3 w-4 transition-transform duration-300 group-hover:-translate-x-1" />
            <span>Previous Property</span>
          </span>
          <span class="font-serif text-2xl">{prevProperty.title}</span>
          <span class="text-xs opacity-75">{prevProperty.price}</span>
        </a>

        <a href={`/properties/${nextProperty.slug}`} class="group flex flex-col gap-2 bg-surface p-6 transition-colors hover:bg-accent hover:text-canvas sm:items-end sm:text-right">
          <span class="inline-flex items-center gap-2 text-[11px] font-medium tracking-[0.16em] text-bronze uppercase">
            <span>Next Property</span>
            <ArrowIcon class="h-3 w-4 transition-transform duration-300 group-hover:translate-x-1" />
          </span>
          <span class="font-serif text-2xl">{nextProperty.title}</span>
          <span class="text-xs opacity-75">{nextProperty.price}</span>
        </a>
      </nav>
    </section>
  </article>
</BaseLayout>
