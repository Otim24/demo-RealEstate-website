---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Demo Real Estate presents premier villas, penthouses, townhouses, and lakeside estates across Uganda, priced in Ugandan Shillings.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-canvas text-ink antialiased">
    <Header />
    <main transition:name="av-page" class="flex-1 overflow-x-clip">
      <slot />
    </main>
    <Footer />
    <WhatsAppWidget />

    <script>
      let revealObserver: IntersectionObserver | null = null;
      let scrollHandlerAttached = false;

      function initScrollProgress() {
        const updateBar = () => {
          const bar = document.getElementById('scroll-progress');
          if (!bar) return;
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = maxScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;
          bar.style.width = `${ratio * 100}%`;
        };

        updateBar();
        if (!scrollHandlerAttached) {
          window.addEventListener('scroll', updateBar, { passive: true });
          scrollHandlerAttached = true;
        }
      }

      function initScrollReveals() {
        if (revealObserver) {
          revealObserver.disconnect();
          revealObserver = null;
        }

        const elements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        if (elements.length === 0) return;

        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReduced || !('IntersectionObserver' in window)) {
          elements.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const target = entry.target as HTMLElement;
              if (entry.isIntersecting) {
                target.removeAttribute('data-reveal-dir');
                target.classList.add('is-visible');
              } else {
                const fromAbove = entry.boundingClientRect.top < 0;
                target.setAttribute('data-reveal-dir', fromAbove ? 'above' : 'below');
                target.classList.remove('is-visible');
              }
            });
          },
          {
            threshold: 0.08,
            rootMargin: '-4% 0px -4% 0px'
          }
        );

        elements.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.92 && rect.bottom > 40) {
            requestAnimationFrame(() => el.classList.add('is-visible'));
          }
          revealObserver?.observe(el);
        });
      }

      function updateActiveNavLinks() {
        const pathname = window.location.pathname;
        document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
          const target = link.getAttribute('data-nav-link') || '';
          const active =
            target === '/'
              ? pathname === '/'
              : pathname === target || pathname.startsWith(`${target}/`);
          link.classList.toggle('is-active', active);
        });
      }

      function initMobileDrawer() {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const closeBtn = document.getElementById('mobile-menu-close');
        const drawer = document.getElementById('mobile-nav-drawer');
        if (!toggleBtn || !drawer) return;

        const openDrawer = () => {
          drawer.classList.remove('pointer-events-none', 'opacity-0');
          drawer.classList.add('pointer-events-auto', 'opacity-100');
          drawer.setAttribute('aria-hidden', 'false');
          toggleBtn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        };

        const closeDrawer = () => {
          drawer.classList.add('pointer-events-none', 'opacity-0');
          drawer.classList.remove('pointer-events-auto', 'opacity-100');
          drawer.setAttribute('aria-hidden', 'true');
          toggleBtn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        };

        toggleBtn.onclick = openDrawer;
        if (closeBtn) closeBtn.onclick = closeDrawer;

        drawer.querySelectorAll('[data-drawer-link]').forEach((link) => {
          link.addEventListener('click', closeDrawer);
        });

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.getAttribute('aria-hidden') === 'false') {
            closeDrawer();
          }
        });
      }

      function initWhatsAppWidget() {
        const toggleBtn = document.getElementById('wa-toggle-btn');
        const closeBtn = document.getElementById('wa-close-btn');
        const popover = document.getElementById('wa-popover');
        const deskSelect = document.getElementById('wa-desk-select') as HTMLSelectElement | null;
        const msgInput = document.getElementById('wa-message-input') as HTMLTextAreaElement | null;
        const launchLink = document.getElementById('wa-launch-link') as HTMLAnchorElement | null;
        const presetBtns = document.querySelectorAll<HTMLButtonElement>('[data-wa-preset]');

        if (!toggleBtn || !popover || !deskSelect || !msgInput || !launchLink) return;

        const syncWhatsAppUrl = () => {
          const phone = deskSelect.value || '256772410890';
          const text = encodeURIComponent(msgInput.value.trim() || 'Hello Demo Real Estate.');
          launchLink.href = `https://wa.me/${phone}?text=${text}`;
        };

        const propertyHeading = document.querySelector<HTMLElement>('[data-property-title]');
        if (propertyHeading) {
          const propName = propertyHeading.getAttribute('data-property-title');
          if (propName) {
            msgInput.value = `Hello Demo Real Estate, I would like to inquire about ${propName}.`;
          }
        }
        syncWhatsAppUrl();

        const setOpen = (open: boolean) => {
          popover.setAttribute('aria-hidden', String(!open));
          toggleBtn.setAttribute('aria-expanded', String(open));
          if (open) {
            popover.classList.remove('invisible', 'pointer-events-none', 'opacity-0', 'translate-y-3', 'scale-95');
            popover.classList.add('pointer-events-auto', 'opacity-100', 'translate-y-0', 'scale-100');
          } else {
            popover.classList.add('invisible', 'pointer-events-none', 'opacity-0', 'translate-y-3', 'scale-95');
            popover.classList.remove('pointer-events-auto', 'opacity-100', 'translate-y-0', 'scale-100');
          }
        };

        toggleBtn.onclick = () => {
          const isOpen = popover.getAttribute('aria-hidden') === 'false';
          setOpen(!isOpen);
        };

        if (closeBtn) {
          closeBtn.onclick = () => setOpen(false);
        }

        deskSelect.onchange = syncWhatsAppUrl;
        msgInput.oninput = syncWhatsAppUrl;

        presetBtns.forEach((btn) => {
          btn.onclick = () => {
            const preset = btn.getAttribute('data-wa-preset') || '';
            msgInput.value = preset;
            syncWhatsAppUrl();
          };
        });
      }

      document.addEventListener('astro:page-load', () => {
        initScrollProgress();
        initScrollReveals();
        updateActiveNavLinks();
        initMobileDrawer();
        initWhatsAppWidget();
      });

      document.addEventListener('astro:before-preparation', () => {
        const drawer = document.getElementById('mobile-nav-drawer');
        if (drawer && drawer.getAttribute('aria-hidden') === 'false') {
          drawer.classList.add('pointer-events-none', 'opacity-0');
          drawer.classList.remove('pointer-events-auto', 'opacity-100');
          drawer.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      });
    </script>
  </body>
</html>
