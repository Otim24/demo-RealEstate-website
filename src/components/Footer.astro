---
import ArrowIcon from './ArrowIcon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
---

<footer class="mt-16 bg-accent text-canvas">
  <div class="mx-auto max-w-[1440px] px-5 py-14 sm:px-8 sm:py-18 lg:px-12 lg:py-20">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12 lg:gap-8">
      <div class="md:col-span-5 lg:col-span-4" data-reveal="fade-left">
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center bg-bronze text-ink">
            <span class="font-serif text-base font-semibold">D</span>
          </span>
          <span class="font-serif text-xl font-semibold tracking-[0.08em] uppercase">Demo Real Estate</span>
        </div>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-canvas/75">
          Uganda's trusted luxury residential brokerage presenting private villas, lakeside estates, and diplomatic penthouses priced transparently in Ugandan Shillings.
        </p>

        <a
          href="https://wa.me/256772410890?text=Hello%20Demo%20Real%20Estate%2C%20I%20would%20like%20to%20connect%20with%20an%20agent."
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex min-h-[46px] items-center gap-2.5 bg-whatsapp px-5 py-2.5 text-xs font-medium tracking-[0.14em] text-canvas uppercase transition-colors hover:bg-bronze hover:text-ink"
        >
          <WhatsAppIcon class="h-4 w-4" />
          <span>WhatsApp Direct Agent</span>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-8 md:col-span-7 lg:col-span-5">
        <div data-reveal="fade-up" data-delay="1">
          <h2 class="text-[11px] font-medium tracking-[0.18em] text-bronze uppercase">Explore</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li>
              <a href="/properties" class="inline-flex min-h-[36px] items-center text-canvas/90 transition-colors hover:text-bronze">
                All Properties
              </a>
            </li>
            <li>
              <a href="/about" class="inline-flex min-h-[36px] items-center text-canvas/90 transition-colors hover:text-bronze">
                About Demo Real Estate
              </a>
            </li>
            <li>
              <a href="/journal" class="inline-flex min-h-[36px] items-center text-canvas/90 transition-colors hover:text-bronze">
                Market Journal
              </a>
            </li>
            <li>
              <a href="/contact" class="inline-flex min-h-[36px] items-center text-canvas/90 transition-colors hover:text-bronze">
                Schedule a Tour
              </a>
            </li>
          </ul>
        </div>

        <div data-reveal="fade-up" data-delay="2">
          <h2 class="text-[11px] font-medium tracking-[0.18em] text-bronze uppercase">Offices</h2>
          <ul class="mt-4 space-y-3 text-sm text-canvas/75">
            <li>
              <span class="block font-medium text-canvas">Kampala (Kololo)</span>
              Acacia Avenue 24, Kololo
            </li>
            <li>
              <span class="block font-medium text-canvas">Entebbe</span>
              Bugonga Road 12, Waterfront
            </li>
            <li>
              <span class="block font-medium text-canvas">Fort Portal</span>
              Kabarole Ridge Office
            </li>
          </ul>
        </div>
      </div>

      <div class="flex flex-col justify-between md:col-span-12 lg:col-span-3" data-reveal="fade-right" data-delay="3">
        <div class="border border-canvas/15 bg-canvas/5 p-5">
          <h2 class="text-[11px] font-medium tracking-[0.18em] text-bronze uppercase">Private Advisory</h2>
          <p class="mt-2 text-xs leading-relaxed text-canvas/75">
            Speak directly with a Kampala or Entebbe senior advisor for verified title checks and private showings.
          </p>
          <a
            href="/contact"
            class="mt-4 inline-flex min-h-[42px] items-center gap-3 bg-bronze px-4 py-2 text-xs font-medium tracking-[0.14em] text-ink uppercase transition-colors hover:bg-canvas"
          >
            <span>Book Consultation</span>
            <ArrowIcon class="h-3 w-4" />
          </a>
        </div>

        <button
          type="button"
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="mt-6 inline-flex min-h-[44px] w-fit items-center gap-2 text-xs tracking-[0.16em] text-canvas/65 uppercase transition-colors hover:text-bronze lg:mt-4"
        >
          <span>Back to top</span>
        </button>
      </div>
    </div>

    <div class="mt-12 flex flex-col justify-between gap-4 border-t border-canvas/15 pt-6 text-xs text-canvas/65 sm:flex-row sm:items-center">
      <p>2026 Demo Real Estate Uganda. All valuations quoted in UGX.</p>
      <p class="tracking-[0.08em] uppercase">Kampala / Entebbe / Fort Portal</p>
    </div>
  </div>
</footer>
